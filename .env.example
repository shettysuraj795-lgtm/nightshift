# NightShift configuration. Copy to .env and fill in the secrets.
# .env is git-ignored; never commit real keys.

# --- LLM provider -----------------------------------------------------------
# OpenRouter is the demo harness only. In a real deployment the same
# OpenAI-compatible client points at an EU-hosted or customer-hosted endpoint
# by changing these two values.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# One model ID per role (see docs/BUILD_PLAN_MVP.md, "Model routing").
TRIAGE_MODEL=
ENRICH_MODEL=
# Must be from a different model family than TRIAGE_MODEL.
JUDGE_MODEL=
# Extended reasoning for the judge (slower, costlier; off gave the same verdicts in testing).
JUDGE_REASONING=false

# Per-call timeout in seconds.
LLM_TIMEOUT_SECONDS=30
# Retries per provider on timeouts, 429 and 5xx (exponential backoff with jitter).
LLM_RETRIES=2
LLM_BACKOFF_INITIAL_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=4
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
# Prompt file in prompts/ (without .md).
TRIAGE_PROMPT=triage_v1
# Confidence reported for rule-based (degraded) answers with a signature match.
DEGRADED_CONFIDENCE=0.5

# --- Guardrails -------------------------------------------------------------
# Abstain (escalate to L2) if the best KB match or the model's confidence is below these.
ABSTAIN_MIN_RETRIEVAL_SCORE=0.70
ABSTAIN_MIN_CONFIDENCE=0.5

# --- Local fallback LLM (Ollama, running natively on the Mac) ---------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# The small local model is slower, so it gets more time per call.
OLLAMA_TIMEOUT_SECONDS=60
# Retrying a local model that timed out rarely helps: it is slow, not flaky.
OLLAMA_RETRIES=0

# --- Infrastructure (docker-compose.yml) ------------------------------------
QDRANT_URL=http://localhost:6333
# Whole seconds; keep short so a Qdrant outage degrades quickly.
QDRANT_TIMEOUT_SECONDS=2
PHOENIX_URL=http://localhost:6006
# OTLP over HTTP; Phoenix also accepts gRPC on 4317.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=nightshift
TRACING_ENABLED=true

# --- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
RETRIEVAL_KB_TOP_K=5
RETRIEVAL_TICKET_TOP_K=3
# Hits below this cosine similarity are ignored.
RETRIEVAL_MIN_SCORE=0.5

# --- Chaos flags (demo) -----------------------------------------------------
# Start-up values; change at runtime with POST /admin/chaos.
CHAOS_LLM_DOWN=false
CHAOS_ALL_LLMS_DOWN=false
CHAOS_VECTOR_DB_DOWN=false

# --- App --------------------------------------------------------------------
# Where the Streamlit UI finds the API.
API_BASE_URL=http://localhost:8000

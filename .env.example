# NightShift configuration. Copy to .env and fill in the secrets.
# .env is git-ignored; never commit real keys.

# --- LLM provider -----------------------------------------------------------
# OpenRouter is the demo harness only. In a real deployment the same
# OpenAI-compatible client points at an EU-hosted or customer-hosted endpoint
# by changing these two values.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# One model ID per role (see docs/BUILD_PLAN_MVP.md, "Model routing").
TRIAGE_MODEL=
ENRICH_MODEL=
# Must be from a different model family than TRIAGE_MODEL.
JUDGE_MODEL=

# Per-call timeout in seconds.
LLM_TIMEOUT_SECONDS=30

# --- Local fallback LLM (Ollama, running natively on the Mac) ---------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Infrastructure (docker-compose.yml) ------------------------------------
QDRANT_URL=http://localhost:6333
PHOENIX_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# --- App --------------------------------------------------------------------
# Where the Streamlit UI finds the API.
API_BASE_URL=http://localhost:8000
